# hackernews ingestor — NO API KEY NEEDED. The defaults work as-is; copy this to
# `.env` only if you want to override them. ingestor.py loads THIS folder's `.env`.

# HN_LIMIT=30          # top stories scanned per poll
# HN_POLL_SECONDS=600  # loop cadence
# HN_PRUNE_DAYS=14     # delete ingested hn-*.md older than this (0 = keep forever)

# Copy to `.env` and fill in. The `.env` is gitignored.
BIMPEAI_API_KEY=sk_xxx                 # BimpeAI Dashboard -> Settings -> API Keys
BIMPEAI_BASE=https://api.bimpe.ai
BIMPEAI_AGENT_ID=                        # filled by setup_agent.py
BRAINDB_BASE_URL=http://localhost:24700  # the isolated bimpeai BrainDB stack
BIMPEAI_POLL_SECONDS=3

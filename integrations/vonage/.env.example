# Copy to .env (gitignored) and fill in. Loaded by server.py from THIS folder only.

# DeepInfra key for the voice agent's LLM (google/gemma-4-31B-it via LiteLLM).
# Same provider the BrainDB stack itself uses — you can copy the key from
# .env.bimpeai.local at the repo root.
DEEPINFRA_API_KEY=

# LiteLLM model string for the conversational agent.
DEEPINFRA_MODEL=deepinfra/google/gemma-4-31B-it

# The isolated BrainDB stack this agent uses as long-term memory.
BRAINDB_BASE_URL=http://localhost:24700

# Local port for this webhook server (kept clear of 24700/24701).
PORT=24710

# Public base URL for building NCCO eventUrls. Leave BLANK to derive it from each
# request's Host header (recommended — survives quick-tunnel URL changes; only the
# dashboard Answer/Event URLs need re-pasting after a tunnel restart).
PUBLIC_BASE_URL=

# Voice + ASR language (BCP-47) and TTS style number for the talk action.
VOICE_LANGUAGE=en-GB
VOICE_STYLE=0

# true = skip the LLM entirely and echo the transcript back (Phase-2 plumbing test).
ECHO_MODE=false
